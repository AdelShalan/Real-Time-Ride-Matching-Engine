# Build
#
# Anchored with a leading slash where the name is a plausible PACKAGE name, not just a
# build directory. An unanchored "out/" matches at ANY depth, and this project's hexagonal
# layout has adapters/out/ — so it silently excluded the entire outbound adapter package,
# including the Redis index, from version control. The build passed locally because the
# files were on disk; a fresh clone would not have compiled.
#
# target/ stays unanchored on purpose: Maven creates one per module, at every depth.
target/
/build/
/out/
/bin/
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.class

# Maven / Gradle
.mvn/timing.properties
.gradle/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
Thumbs.db

# Scratch request payloads used when poking the API by hand
ride.json
*.request.json

# Local env & secrets
.env
.env.*
!.env.example
*.local

# Observability / load test output
k6-results/
*.log
logs/

# Docker volumes
.data/
