<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ridematching</groupId>
  <artifactId>ride-matching-engine</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Real-Time Ride-Matching Engine</name>
  <description>Event-driven ride dispatch backend</description>

  <!--
    Deliberately NOT inheriting from spring-boot-starter-parent. The BOM is imported
    below instead, so this build owns its own plugin configuration and the domain
    module can stay free of any Spring inheritance. See ADR-0001.
  -->

  <!--
    libs are listed individually: they share no common dependency set (domain has none
    at all), so an aggregator would add a file without removing duplication.
    services do share one, so they get a parent POM of their own.
  -->
  <modules>
    <module>libs/domain</module>
    <module>libs/events</module>
    <module>libs/platform</module>
    <module>services</module>
  </modules>

  <properties>
    <!--
      Built and run on JDK 25 (LTS), but bytecode is deliberately still targeted at 21.
      The reason for the upgrade is JEP 491 (JDK 24), which removed virtual-thread pinning
      on synchronized blocks — a JVM RUNTIME behaviour, not a bytecode feature. Keeping the
      release target at 21 gets the whole benefit with none of the toolchain risk: ArchUnit
      and other bytecode readers never have to parse class-file version 69.
      Raising this to 25 is a separate decision, to be made for language features on merit.
    -->
    <java.version>25</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>4.1.1</spring-boot.version>
    <archunit.version>1.3.0</archunit.version>
    <!-- Mirrors the testcontainers.version property in spring-boot-dependencies 4.1.1. -->
    <testcontainers.version>2.0.5</testcontainers.version>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        Pinned to the exact version spring-boot-dependencies declares in its
        testcontainers.version property. Boot 4 sets that property but does not import the
        BOM, so the import has to be explicit — while still tracking Boot's tested version
        rather than being chosen independently.
      -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- Internal modules: version declared once, referenced without one elsewhere. -->
      <dependency>
        <groupId>com.ridematching</groupId>
        <artifactId>domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ridematching</groupId>
        <artifactId>events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ridematching</groupId>
        <artifactId>platform</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <compilerArgs>
              <!-- Keep parameter names at runtime: Spring and Jackson both rely on them. -->
              <arg>-parameters</arg>
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>

        <!-- Unit tests: *Test. Fast, no infrastructure. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
          </configuration>
        </plugin>

        <!-- Integration tests: *IT. Testcontainers-backed, bound to verify. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
